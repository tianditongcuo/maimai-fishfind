{
  "manifest_version": 2,
  "id": "maimai.fishfind",
  "version": "1.2.2",
  "name": "麦麦找鸡",
  "description": "以图反查图片来源与 coser 社交账号（Google Lens / SauceNAO / trace.moe，可抽出 Twitter/微博/B站/小红书/抖音/Instagram/TikTok 账号）。提供 LLM 工具 fish_find 与 /麦麦找鸡 指令，反查走自带 Node 命令行，不消耗 token。本插件是「鱼鱼找鸡 v1.0.0」（作者：小鲸鱼，MIT）的修改版，非上游官方版本；来源与改动见 NOTICE.md。",
  "author": {
    "name": "tianditongcuo",
    "url": "https://github.com/tianditongcuo"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/tianditongcuo/maimai-fishfind",
    "homepage": "https://github.com/tianditongcuo/maimai-fishfind",
    "documentation": "https://github.com/tianditongcuo/maimai-fishfind/blob/main/README.md",
    "issues": "https://github.com/tianditongcuo/maimai-fishfind/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "plugin_type": "extension",
  "dependencies": [],
  "capabilities": [
    "send.text",
    "message.get_by_id",
    "message.get_recent"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "changelog": "CHANGELOG.md"
}
